+  if (req.method !== "POST") return json(res, { error: "Método no permitido" }, 405);
+  const user = await currentUserFromRequest(req);
+  if (!user) return json(res, { error: "Inicia sesión" }, 401);
+  if (user.role === "admin") return json(res, { error: "Usa una cuenta de cliente" }, 403);
+
+  const orderId = req.body?.orderId;
+  if (!orderId) return json(res, { error: "Pedido requerido" }, 400);
+  const order = await getOrder(String(orderId));
+  if (!order || order.userId !== user.id) return json(res, { error: "Pedido no encontrado" }, 404);
+
+  try {
+    const { order: saved, preference } = await reopenOrderPreference({ order, payer: user, req });
+    return json(res, {
+      order: saved,
+      id: preference.id,
+      init_point: preference.init_point,
+      sandbox_init_point: preference.sandbox_init_point,
+    });
+  } catch (error) {
+    console.error("MP checkout", error.detail || error);
+    return json(res, { error: error.message || "Error Mercado Pago" }, error.status || 500);
+  }
+}
diff --git a/src/pages/api/mercadopago/sync.js b/src/pages/api/mercadopago/sync.js
new file mode 100644
index 0000000..18333b0
--- /dev/null
+++ b/src/pages/api/mercadopago/sync.js
@@ -0,0 +1,33 @@
+import { currentUserFromRequest, json } from "@/lib/store/http";
+import { mpFetch } from "@/lib/store/mercadopago";
+import { applyMercadoPagoPayment } from "@/lib/store/payments";
+import { readOrderIdFromPayment } from "@/lib/store/payment-decision";
+import { getOrder } from "@/lib/store/services";
+
+/**
+ * La página de retorno consulta el pago en Mercado Pago.
+ * El webhook sigue siendo la fuente de verdad; esto solo adelanta el mismo efecto.
+ */
+export default async function handler(req, res) {
+  if (req.method !== "POST") return json(res, { error: "Método no permitido" }, 405);
+  const user = await currentUserFromRequest(req);
+  if (!user) return json(res, { error: "Inicia sesión" }, 401);
+
+  const paymentId = req.body?.paymentId || req.body?.collectionId;
+  if (!paymentId) return json(res, { error: "Falta el id del pago" }, 400);
+
+  try {
+    const payment = await mpFetch(`/v1/payments/${paymentId}`);
+    const orderId = readOrderIdFromPayment(payment);
+    const existing = orderId ? await getOrder(orderId) : null;
+    if (!existing || (user.role !== "admin" && existing.userId !== user.id)) {
+      return json(res, { error: "Pedido no encontrado" }, 404);
+    }
+    const result = await applyMercadoPagoPayment(payment);
+    const order = await getOrder(orderId);
+    return json(res, { order, result, mpStatus: payment.status || null });
+  } catch (error) {
+    console.error("MP sync", error.detail || error);
+    return json(res, { error: error.message || "No se pudo consultar el pago" }, error.status || 500);
+  }
+}
diff --git a/src/pages/api/mercadopago/webhook.js b/src/pages/api/mercadopago/webhook.js
new file mode 100644
index 0000000..57d2c3b
--- /dev/null
+++ b/src/pages/api/mercadopago/webhook.js
@@ -0,0 +1,32 @@
+import { json } from "@/lib/store/http";
+import { mpFetch, readWebhookNotification, verifyMercadoPagoWebhook } from "@/lib/store/mercadopago";
+import { applyMercadoPagoPayment } from "@/lib/store/payments";
+
+/**
+ * Webhook Mercado Pago, mismo contrato que NewWapifood:
+ * topic=payment + id, firma x-signature, consulta GET /v1/payments/:id.
+ * A diferencia de WapiFood, un error de base de datos responde 500 para que MP reintente.
+ * Firma inválida: 401. Aviso que no es un pago: 200.
+ */
+export default async function handler(req, res) {
+  if (req.method !== "POST" && req.method !== "GET") {
+    return json(res, { error: "Método no permitido" }, 405);
+  }
+
+  try {
+    const note = readWebhookNotification(req);
+    if (note.topic === "payment" && note.paymentId) {
+      const signature = verifyMercadoPagoWebhook(req, note.signatureId);
+      if (!signature.ok) {
+        return json(res, { status: "unauthorized", reason: signature.reason }, 401);
+      }
+      const payment = await mpFetch(`/v1/payments/${note.paymentId}`);
+      const result = await applyMercadoPagoPayment(payment);
+      return json(res, { status: "success", ...result });
+    }
+    return json(res, { status: "ignored", topic: note.topic, paymentId: note.paymentId || null });
+  } catch (error) {
+    console.error("MP webhook error", error);
+    return json(res, { status: "error", message: error.message || "Error" }, 500);
+  }
+}
