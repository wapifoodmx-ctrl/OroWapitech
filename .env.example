# Copia a .env.local. No pongas secretos reales en este archivo.
# Las variables se leen cuando la función corre (no hace falta repetirlas con otro nombre).

# Supabase — las que usa el sitio en Vercel
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Alias opcionales (si ya las tenías con otro nombre)
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_COUNTRY=MX

# Ya no se usan (se pueden borrar de Vercel):
# OL_JWT_SECRET
# RESEND_API_KEY
# MAIL_FROM

# Solo desarrollo: simula la preferencia sin llamar a Mercado Pago. No lo actives en Vercel.
# MERCADO_PAGO_MOCK=1
