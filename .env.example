# Copia a .env.local. No pongas secretos reales en este archivo.
# El build de Next no debe fallar si faltan: se leen al cobrar o al consultar Supabase.

# Supabase — servidor
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Supabase — navegador (las mismas URLs/llaves públicas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Auth propia
OL_JWT_SECRET=

# Correo OTP (opcional). Sin RESEND_API_KEY el código se imprime en la consola del servidor.
RESEND_API_KEY=
MAIL_FROM=

# Mercado Pago — los mismos nombres que NewWapifood
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_COUNTRY=MX

# Solo desarrollo: simula la preferencia sin llamar a Mercado Pago. No lo actives en Vercel.
# MERCADO_PAGO_MOCK=1
